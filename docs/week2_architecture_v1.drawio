<mxfile host="app.diagrams.net"><diagram name="DuitWise V1" id="duitwise-v1"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1860" pageHeight="1060" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;DuitWise MY — V1 Conceptual Architecture&lt;/b&gt;" style="text;html=1;fontSize=28;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1300" height="44" as="geometry"/></mxCell><mxCell id="sub" value="Topic 2 Lab, Part C  |  Components labelled by function; specific technologies chosen in later topics  |  [IDs] = requirements each component supports" style="text;html=1;fontSize=13;align=left;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1350" height="24" as="geometry"/></mxCell><mxCell id="simple" value="&lt;b&gt;Step C1 starting point:&lt;/b&gt; User query &amp;rarr; AI application &amp;rarr; AI capability (language model) &amp;rarr; Response&lt;br&gt;&lt;i&gt;Not enough on its own: no official grounding, citations, year checks, advice refusal or privacy control. Components below were added only where a requirement needs them.&lt;/i&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="1350" height="70" as="geometry"/></mxCell><mxCell id="user" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;User&lt;/b&gt;&lt;br&gt;Young working adult&lt;br&gt;(English or BM question)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Application Interface&lt;/b&gt;&lt;br&gt;Web chat on phone / laptop&lt;br&gt;Shows answer + source + year&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR7]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="pii" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Privacy Control&lt;/b&gt;&lt;br&gt;Masks IC, bank &amp; phone&lt;br&gt;numbers before model / logs&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[RAI3]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="scope" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Scope / Safety Control&lt;/b&gt;&lt;br&gt;Detects investment-advice &amp;&lt;br&gt;out-of-scope requests&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR6, RAI1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="ka" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Knowledge Access&lt;/b&gt;&lt;br&gt;Finds relevant passages,&lt;br&gt;filtered by agency &amp; year&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR1-FR3, FR5, NFR2]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="ks" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Knowledge Source&lt;/b&gt;&lt;br&gt;Official LHDN, KWSP, AKPK&lt;br&gt;docs + metadata (agency,&lt;br&gt;year, link)&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR1-FR4, NFR3]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="560" width="260" height="130" as="geometry"/></mxCell><mxCell id="ing" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Document Update Process&lt;/b&gt;&lt;br&gt;(offline) add / replace docs&lt;br&gt;by year, no code change&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[NFR5]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1560" y="830" width="260" height="130" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Official Agency Websites&lt;/b&gt;&lt;br&gt;hasil.gov.my, kwsp.gov.my,&lt;br&gt;akpk.org.my (public docs)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFFFFF;strokeColor=#999999;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1180" y="830" width="260" height="130" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Language Model Service&lt;/b&gt;&lt;br&gt;Writes plain-language answer&lt;br&gt;from passages, in user&#x27;s&lt;br&gt;language&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR7, NFR1]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="560" width="260" height="130" as="geometry"/></mxCell><mxCell id="cite" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Citation &amp; Currency Check&lt;/b&gt;&lt;br&gt;Source present? Year stated?&lt;br&gt;Evidence enough? Else&lt;br&gt;&quot;not found&quot; / verify notice&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[FR4, FR5, FR8, RAI2, RAI5]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="560" width="260" height="130" as="geometry"/></mxCell><mxCell id="resp" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Response / Output&lt;/b&gt;&lt;br&gt;Answer + source reference +&lt;br&gt;year, OR refusal + redirect,&lt;br&gt;OR &quot;not found&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="260" height="130" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Evaluation Point&lt;/b&gt;&lt;br&gt;Gold test set: correctness,&lt;br&gt;numbers, citations, refusal;&lt;br&gt;latency &amp; cost logs (masked)&lt;br&gt;&lt;b style=&#x27;font-size:11px;color:#8A2B00&#x27;&gt;[O3, NFR1-NFR4, NFR6]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="830" width="260" height="130" as="geometry"/></mxCell><mxCell id="e0" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui" target="pii"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="masked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pii" target="scope"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="in-scope" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="scope" target="ka"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="search by agency/year" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ka" target="ks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="passages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="ks" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scope" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="draft answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm" target="cite"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="checked answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cite" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="refusal + redirect (AKPK / adviser / LHDN / KWSP)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="scope" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="answer shown in interface" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="resp" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="PDFs / pages" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="web" target="ing"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="indexed docs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ing" target="ks"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="masked logs, latency, cost" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;fontStyle=2;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="resp" target="eval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;background:#F5F5F5;border:1px solid #666666&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; User, interface &amp; output&lt;br&gt;&lt;span style=&#x27;background:#DAE8FC;border:1px solid #6C8EBF&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; AI capability&lt;br&gt;&lt;span style=&#x27;background:#D5E8D4;border:1px solid #82B366&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Data / knowledge&lt;br&gt;&lt;span style=&#x27;background:#FFE6CC;border:1px solid #D79B00&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Responsible AI / safety control&lt;br&gt;&lt;span style=&#x27;background:#E1D5E7;border:1px solid #9673A6&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Evaluation point&lt;br&gt;- - - Evaluation data flow" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;strokeColor=#999999;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1308" y="20" width="300" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>